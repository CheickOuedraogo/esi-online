# ── Base de données ─────────────────────────────────────────────────────────
# URL de connexion a la base PostgreSQL
# (docker-compose : le mot de passe doit correspondre a POSTGRES_PASSWORD)
DATABASE_URL=postgres://esi:change-me@localhost:5432/esi_library

# Mot de passe PostgreSQL (utilise par docker-compose.yml, jamais commite)
POSTGRES_PASSWORD=change-me

# ── Application ─────────────────────────────────────────────────────────────
# Secret de signature / chiffrement des sessions (>= 32 caracteres)
# Generer avec : openssl rand -base64 48
SESSION_SECRET=change-me-to-a-random-string-at-least-32-chars

# Dossier de stockage local des fichiers televerses
UPLOAD_DIR=./uploads

# Taille maximale d'un fichier televerse (en Mo)
MAX_UPLOAD_MB=50

# URL publique de l'application (doit correspondre au domaine)
APP_URL=http://localhost:3000

# ── Domaine public (VPS uniquement) ─────────────────────────────────────────
# Nom de domaine pointant vers le VPS (ex. esi-library.bf) : Caddy obtient
# alors automatiquement un certificat HTTPS (Let's Encrypt).
# Laisser vide en local (service sur http://localhost:80, sans HTTPS).
APP_DOMAIN=

# ── Compte admin initial (utilise par le seed) ──────────────────────────────
ADMIN_EMAIL=admin@esi.bf
ADMIN_PASSWORD="Admin123!@#"
