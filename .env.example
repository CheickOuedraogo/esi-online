# URL de connexion a la base PostgreSQL
DATABASE_URL=postgres://esi:esi@localhost:5432/esi_library

# Secret de signature / chiffrement des sessions
SESSION_SECRET=change-me-to-a-random-string-at-least-32-chars

# Dossier de stockage local des fichiers televerses
UPLOAD_DIR=./uploads

# Taille maximale d'un fichier televerse (en Mo)
MAX_UPLOAD_MB=50

# URL publique de l'application
APP_URL=http://localhost:3000

# Compte admin initial (utilise par le seed)
ADMIN_EMAIL=admin@esi-library.dz
ADMIN_PASSWORD=Admin123!@#
