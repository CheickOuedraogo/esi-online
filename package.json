{
  "name": "esi-library",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "init": "tsx scripts/setup.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file=.env src/server/db/seed.ts",
    "storage:check": "tsx --env-file=.env scripts/check-storage-consistency.ts",
    "test": "tsx --env-file=.env --test tests/back/auth.test.ts tests/back/storage.test.ts tests/back/contracts.test.ts"
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "drizzle-orm": "^0.36.0",
    "next": "^15.0.0",
    "pg": "^8.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "drizzle-kit": "^0.28.0",
    "eslint": "^9.13.0",
    "eslint-config-next": "^15.5.27",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.1"
  }
}
