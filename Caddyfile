# Caddyfile : terminaison HTTPS (certificats automatiques) et reverse proxy
# du domaine public vers l'application Next.js (service app, port 3000).

:80 {
    reverse_proxy app:3000

    encode gzip zstd

    header {
        X-Content-Type-Options "nosniff"
        # SAMEORIGIN autorise l'aperçu inline des PDF dans une iframe de l'application
        # tout en bloquant l'intégration du site par des domaines tiers.
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }
}
